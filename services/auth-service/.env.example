# Generated .env for auth-service
APP_NAME=auth-service
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

# Eureka Configuration
EUREKA_SERVER=http://localhost:8761/eureka/

# 💻 Development Database Configuration (Local MySQL)
LOCAL_DB_URL=jdbc:mysql://localhost:3306/parkease_auth_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
LOCAL_DB_USERNAME=root
LOCAL_DB_PASSWORD=pallavi

# ☁️ Production Database Configuration (Aiven Cloud MySQL)
DB_URL=jdbc:mysql://<AIVEN_HOST>:<AIVEN_PORT>/parkease_auth_db?useSSL=true&requireSSL=true&verifyServerCertificate=false&allowPublicKeyRetrieval=true
DB_USERNAME=<AIVEN_USERNAME>
DB_PASSWORD=<AIVEN_PASSWORD>

# JPA / Logging
LOCAL_JPA_SHOW_SQL=false
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=true

# JWT Authentication
JWT_SECRET=4f6b6a6c6d6e6f707172737475767778797a3132333435363738393061626364
JWT_EXPIRATION=86400000

# CORS / Security
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173
INTERNAL_GATEWAY_SECRET=ParkEaseGateway2024

PRODUCTION_SERVICE_URL=https://parkease-auth.onrender.com
