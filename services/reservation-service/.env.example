# Generated .env for reservation-service
APP_NAME=reservation-service
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8084

# Eureka Configuration
EUREKA_SERVER=http://localhost:8761/eureka/

# 💻 Development Database Configuration (Local MySQL)
LOCAL_DB_URL=jdbc:mysql://localhost:3306/parkease_reservation_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
LOCAL_DB_USERNAME=root
LOCAL_DB_PASSWORD=pallavi

# ☁️ Production Database Configuration (Aiven Cloud MySQL)
DB_URL=jdbc:mysql://<AIVEN_HOST>:<AIVEN_PORT>/parkease_reservation_db?useSSL=true&requireSSL=true&verifyServerCertificate=false&allowPublicKeyRetrieval=true
DB_USERNAME=<AIVEN_USERNAME>
DB_PASSWORD=<AIVEN_PASSWORD>

# JPA / Logging
LOCAL_JPA_SHOW_SQL=false
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=true

# CORS / Security
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173
INTERNAL_GATEWAY_SECRET=ParkEaseGateway2024

# Inter-Service Routing Telemetry
PARKEASE_SPOTS_SERVICE_URL=http://parking-spot-service/spots
PARKEASE_LOTS_SERVICE_URL=http://parking-lot-service/lots

PRODUCTION_SERVICE_URL=https://parkease-reservations.onrender.com
